{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.silex-research/dontpanic",
  "title": "DontPanic",
  "description": "Local MCP server to plan, dispatch, review, and gate AI coding work.",
  "repository": {
    "url": "https://github.com/Silex-Research/DontPanic",
    "source": "github"
  },
  "websiteUrl": "https://github.com/Silex-Research/DontPanic",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "dontpanic-orchestrate",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
