# Credentials and secrets — NEVER commit these
.env
.env.*
*.p12
*.pem
*.key
**/auth.json
**/oauth_creds.json
**/trustedFolders.json
**/mcp-needs-auth-cache.json
.secrets/
*.serviceaccount.json

# Session data (large, ephemeral)
**/history.jsonl
**/debug/
**/file-history/
**/telemetry/
**/stats-cache.json
**/statsig/
**/paste-cache/
**/shell-snapshots/
**/session-env/
**/sessions/
**/*.sqlite
**/*.jsonl

# Orchestration plan artifacts (decisions, audit chains) — tracked, schema-validated
!/docs/plans/**/*.jsonl
!/docs/plans/*/decisions.jsonl

# Plan G runtime-evidence fixtures use .jsonl as a tested format shape
!/scripts/dontpanic_orchestrate/tests/runtime_evidence/**/*.jsonl
# Convergence v1.1 real-ledger fixture corpora (C0 + worktree-v0 rounds)
!/scripts/dontpanic_orchestrate/tests/fixtures/convergence_rounds/*.jsonl

# Python bytecode
**/__pycache__/
**/*.pyc
**/*.egg-info/

# Node
node_modules/
package-lock.json

# OS artifacts
.DS_Store
Thumbs.db

# Per-repo environments registry (real project IDs). Committed shape is
# environments.json.example with placeholders. Real values are generated
# locally (manual edit or scripts/bootstrap.sh) and never committed.
/environments.json

# Local campaign convenience overrides (billing accounts, project shortcuts)
.env.local

# Codex auth/state
codex/auth.json
codex/logs_*.sqlite
codex/history.jsonl

# Gemini auth/state
gemini/oauth_creds.json
gemini/state.json
gemini/google_accounts.json
gemini/installation_id
gemini/tmp/

# Cursor project-specific
cursor/projects/
.firebase/

# Firebase project alias config — local per maintainer; tracked as .firebaserc.example
/.firebaserc

# Operator-local Firebase web SDK config for the dashboard adapter.
# Created from dashboard/config-firebase.example.js, holds apiKey/appId — never commit.
dashboard/firebase-config.local.js

# Dashboard projection/cache exports — regenerated by `dontpanic dashboard build`.
# Runtime state can contain private project names, costs, paths, and operator
# data. Keep demo/test data under dashboard/tests/fixtures instead.
dashboard/state/*.json
dashboard/state/architecture-status.json
dashboard/state/architecture-view-state.json
dashboard/state/capabilities-status.json
dashboard/state/decisions.json
dashboard/state/evidence_refs.json
dashboard/state/fleet-summary.json
dashboard/state/fleet-what-now.json
dashboard/state/gates.json
dashboard/state/inbox.json
dashboard/state/manifest.json
dashboard/state/plans.json
dashboard/state/quota.json
dashboard/state/reconcile-status.json
dashboard/state/state-snapshot.json
dashboard/state/supervisors.json
dashboard/state/what-now.json
dashboard/state/projects/

# Canonical-backfill evidence (plan 2026-06-17-001 F002 / C4). Local operator
# evidence captured while temp worktrees still existed; maps observed path keys
# to durable canonical repos. NEVER committed — it can reference private paths.
# Consumed by `dontpanic projects backfill-canonical`. The default lives under
# $DONTPANIC_HOME; this guard covers a repo-local override of DONTPANIC_HOME.
.dontpanic/canonical-backfill-evidence.json

# Maintainer-private convenience scripts (campaign-specific billing queries,
# personal cron wrappers, etc.) — clearly out of the OSS surface.
/scripts/maintainer/

# Architecture map HTML — regenerated locally on demand (plan
# 2026-05-19-004 F002). architecture.json IS tracked; the HTML is not.
docs/architecture/architecture.html

# Install report HTML — regenerated locally on demand (plan
# 2026-05-19-002 F004). Produced by `dontpanic doctor --profile=<name>
# --report` or `dontpanic init --report`.
docs/install-report.html
build/
