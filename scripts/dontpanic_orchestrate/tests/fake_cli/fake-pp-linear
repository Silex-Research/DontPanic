#!/usr/bin/env python3
"""F003 smoke fixture — stands in for the PP-emitted Linear MCP binary.

The real binary is generated by the operator's one allotted paid
``/printing-press linear`` invocation; this fixture lets the smoke
test exercise the DontPanic-side wrapper end-to-end (subprocess spawn
+ JSON-RPC stdio + redact + sanitize) without burning the budget.

Protocol: one JSON-RPC envelope per line on stdin, one response per
line on stdout. Tool dispatch:

  * ``issue``   — returns a Linear-shaped issue payload with NO secret
                  material in the body (real Linear responses don't
                  echo back the caller's bearer token). Drives the
                  "post-redact response with no leaked tokens" trace.
  * ``leaky``   — returns a payload that DOES contain a bearer-token
                  -shaped substring. Drives the fail-closed assertion:
                  ``SanitizationFailed`` must propagate.
  * any other   — error envelope.
"""

from __future__ import annotations

import json
import sys


def _issue_response() -> dict:
    return {
        "result": {
            "id": "ISS-DP-42",
            "identifier": "DP-42",
            "title": "Ship the printing-press-adapter F003 dogfood",
            "state": {"id": "STATE-1", "name": "In Progress"},
            "team": {"id": "TEAM-DONTPANIC", "key": "DP"},
            "url": "https://linear.app/dontpanic/issue/DP-42",
            "createdAt": "2026-05-10T00:00:00.000Z",
            "updatedAt": "2026-05-20T00:00:00.000Z",
        }
    }


def _leaky_response() -> dict:
    # Synthetic payload that simulates a misconfigured PP binary
    # echoing back the caller's credential. The wrapper must catch
    # this even though the placeholder ``apply_redact`` is lenient.
    return {
        "result": {
            "id": "LEAK-1",
            "title": "Diagnostic dump (should never cross the boundary)",
            "raw_request_header": "Authorization: Bearer lin_api_FAKE_TOKEN_FOR_FAIL_CLOSED_TEST_abcdefghijklmnopqrstuvwxyz",
        }
    }


def _dispatch(envelope: dict) -> dict:
    method = envelope.get("method")
    params = envelope.get("params") or {}
    name = params.get("name")
    if method != "tools/call":
        return {"error": {"code": -32601, "message": f"unknown method {method!r}"}}
    if name == "issue":
        return _issue_response()
    if name == "leaky":
        return _leaky_response()
    return {"error": {"code": -32602, "message": f"unknown tool {name!r}"}}


def main() -> int:
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            envelope = json.loads(raw)
        except json.JSONDecodeError:
            sys.stdout.write(
                json.dumps({"jsonrpc": "2.0", "id": None, "error": "invalid json"}) + "\n"
            )
            sys.stdout.flush()
            continue
        response_body = _dispatch(envelope)
        response_body.setdefault("jsonrpc", "2.0")
        response_body["id"] = envelope.get("id", 1)
        sys.stdout.write(json.dumps(response_body) + "\n")
        sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
