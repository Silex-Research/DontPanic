rules_version = '2';

// DontPanic realtime dashboard adapter.
// Browser clients may read mirrored projection state after Firebase Auth.
// All writes are server-side via Admin SDK (sync daemon / Cloud Functions);
// client SDK writes are denied.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
